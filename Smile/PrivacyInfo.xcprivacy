<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 本 App 不追踪用户跨 App 或跨网站行为 -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- 无追踪域名 -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
		本 App 所有数据均存储在用户设备本地（SwiftData + Documents 目录），开发者没有服务器，不收集用户数据。
		例外：用户主动使用「AI 整理」时，App 会把该条记录的标题和正文文字直接发送到用户自己配置的
		AI 服务商（用户自备 API Key），不经过开发者。首次发往某个服务商地址前会弹窗说明并征得同意。
		这类由用户自选第三方处理的数据是否需要在此声明，待上架前确认，目前未声明。
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- 必须声明理由的 API 使用情况 -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>

		<!--
			文件时间戳 API（NSPrivacyAccessedAPICategoryFileTimestamp）
			使用场景：
			  - MediaStore 在 Documents/Media/ 目录下创建、复制、移动媒体文件
			  - ExportService / ImportService 通过 NSFileCoordinator 和 FileManager
			    对 App 容器内临时目录及备份文件进行读写操作
			  - ZIPFoundation 在压缩 / 解压过程中访问文件元数据
			  - ImportService 处理用户通过文档选取器打开的 .smilejar / .zip 备份文件
			  - SharedInbox 读取 App Group 容器 ShareInbox/ 下目录的创建时间，
			    用于按分享先后处理照片、清理过期临时目录
			理由：
			  C617.1 —— 访问 App 容器 / App Group 容器内（Documents/Media/、临时目录、ShareInbox/）文件的元数据，
			            仅用于 App 内部文件管理，不对外传输。
			  3B52.1 —— 访问用户通过文档选取器明确授权的备份文件的元数据（导入还原功能）。
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>

		<!--
			UserDefaults API（NSPrivacyAccessedAPICategoryUserDefaults）
			使用场景：
			  - 详情页排版风格（@AppStorage）
			  - AI 整理的服务商配置（不含 API Key，Key 只存钥匙串）及用户已同意发送的服务商地址
			理由：
			  CA92.1 —— 只读写本 App 自己的配置，不与其它 App 共享。
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

	</array>
</dict>
</plist>
