<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>微笑储蓄罐</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Smile备份</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>com.chuzhanfeng.smilepiggybank.backup</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.6</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.chuzhanfeng.smile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>smilejar</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>微笑储蓄罐需要使用相机，以便你在记账时直接拍摄照片作为记录的配图。例如，拍下和孩子的温馨互动瞬间，放入微笑储蓄罐中。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>用于验证身份以查看加密的储蓄罐和条目</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>微笑储蓄罐需要使用麦克风，以便你为储蓄记录录制语音备注。例如，用语音记当下的心情和感悟。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>微笑储蓄罐需要访问照片图库，以便你从相册中选择照片或视频添加到储蓄记录。例如，记录孩子的获奖证书到优势储蓄罐中。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>微笑储蓄罐使用语音识别，将你的录音和实时听写转换为文字，方便快速输入与搜索记录。例如，通过语音转文字的方式便捷记录当下心情和感悟。</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UIStatusBarStyle</key>
	<string></string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Smile 加密备份</string>
			<key>UTTypeIdentifier</key>
			<string>com.chuzhanfeng.smilepiggybank.backup</string>
			<key>UTTypeTagSpecification</key>
